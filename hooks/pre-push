#!/bin/sh
# pre-push — ★押す 時に 必ず 網を 走らせる★（司さん 2026-09-24「2 検査する必要があるならやれ」）
# ==============================================================================
# ★なぜ 要るか★
#   2026-09-22 に 決めた「説明・見本に ★本物に 見える 字★を 書かない」の ★限り★が
#   「★網（tools/oshu-mae.mjs）を 回さずに 押せば 効かない★」＝★人の 心がけ★だった。
#   ⇒ ★押す 時に 機械が 回す★形に する。
#
# ★★この 網が ★直さない 事★（先に 書く）★★
#   ・★「まとめて push すると GitHub は 先頭 1本しか 検査を 作らない」は 直りません★
#     （2026-09-22 実測＝`c60fe41` は 走り 0本）。
#     ⇒ ★これは ★押す 前★の 網／GitHub の 検査とは ★別の 物★★。
#     ⇒ ★1件ずつ 押す★のは 今までどおり ★人が 守る★。
#   ・★実ブラウザ・倉庫を 触る 段は 回しません★（重いので 外して いる＝出しに 本数が 出る）。
#   ・★webkit.yml は 見ません★（網が 見るのは `ci.yml` だけ）。
#
# ★逃げ道★
#   `git push --no-verify` で ★この 網を 飛ばせます★。
#   ⇒ ★飛ばしたら 出しに そう 書く★（黙って 飛ばさない）。
#
# ★どこに 置いて あるか★
#   ★`.git/hooks` では なく repo の `hooks/` に 置いて `core.hooksPath` で 指して います★。
#   ★訳★＝`.git/hooks` は ★clone にも 新しい worktree にも 付いて 来ない★＝
#     ★黙って 効かなく なる★（[[feedback_atarashii_worktree_ni_wa_node_modules_ga_nai]] と 同じ 家）。
#   ★新しい 手元で 効かせる には 1回だけ★ … `git config core.hooksPath hooks`
#
# ★重さ（2026-09-22 実測）★ … 223段 で ★約 5〜9分★。★押す たびに 掛かります★。
# ★★★2026-09-28 指示役1＝★git が hook に 渡す `GIT_DIR` を 捨てる★★★
#   ★★これが 無いと ★別の 作業場(worktree)から 押した 時だけ★ 2つ 壊れます★★
#
#   ★実測（★別の 場所に 仮の repo と 仮の 遠くを 作って 測った★）★
#     ㋐主の 手元から 押す …… `GIT_DIR=[]`
#        ⇒ 段の 中の `git -C <仮> init` … ★仮の repo が 出来る（YES）★
#        ⇒ `core.bare` …………… ★false の まま★
#     ㋑★別の 作業場から 押す★ … `GIT_DIR=[<主>/.git/worktrees/<名>]`  ★git が 自分で 渡す★
#        ⇒ 段の 中の `git -C <仮> init` … ★★仮の repo が 出来ない（NO）★★
#           ＝★`-C` は `GIT_DIR` を 打ち消さない★＝★git は GIT_DIR の 方を 初期化する★
#        ⇒ `core.bare` …………… ★★true に なる（主の config が 書き換わる）★★
#           ＝★作業場からは 作業の 木が 見えない ので git が bare と 書く★
#     ㋒★この unset を 足して もう 一度 別の 作業場から 押す★
#        ⇒ `GIT_DIR=[]` ／ 仮の repo ★YES★ ／ `core.bare` ★false の まま★
#
#   ★本物で 何が 起きて いたか（2026-09-28）★
#     ・`tests/supa-config-env-matches-repo.test.mjs --self-test` が
#       ★別の 作業場から 押した 回だけ 赤★（2回とも）
#       ／★主の 手元から 押した 回は 緑★／★押しの 外で 226段 丸ごと 回しても 赤 0★
#     ・同じ 2回に ★`core.bare = true`★ が 起きた（別の 席の 作業が 止まった）
#   ⇒ ★★＝『押す 物 だけの 作業場から 押す』は ★この 1行が 無いと 使えません★★★
#   ⇒ ★★この 1行が 在れば ★使えます★＝『網が 見た 字 ＝ 押した 物』が 言えます★★
#
#   ★なぜ 4つ 全部 捨てるか★ … `GIT_DIR` だけ 捨てても
#     `GIT_WORK_TREE` `GIT_INDEX_FILE` `GIT_PREFIX` が 残ると ★別の 所で 同じ 事が 起きる★。
#     ★段は 226本 在り、どれが git を 呼ぶかを 人が 覚えて いられない★ ので ★入口で 捨てる★。
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

set -e
echo "[pre-push] ★押す前の 網を 回します★（飛ばすなら git push --no-verify）"
if ! command -v node > /dev/null 2>&1; then
  echo "[pre-push] ★node が 無いので 回せません★＝★止めます★（0件＝合格 とは しない）"
  exit 1
fi
node tools/oshu-mae.mjs
